/** @file
 *
 * Bremsstrahlung test: ions on a regular lattice at BASE_DENSITY_SI (uniform deposited density) and randomly placed
 * electrons with the drift of particle.param.
 *
 * The electrons get their own random positions. Electrons derived from the ions would sit on their parent ion,
 * and the interpolated ion density would then contain the self term of the parent ion (about 1 % at 20 per cell).
 */

#pragma once

#include "picongpu/particles/InitFunctors.hpp"

namespace picongpu
{
    namespace particles
    {
        using InitPipeline = pmacc::mp_list<
            CreateDensity<densityProfiles::Homogenous, startPosition::Quiet, PIC_Ions>,
            CreateDensity<densityProfiles::Homogenous, startPosition::Random, PIC_Electrons>,
            Manipulate<manipulators::AssignXDrift, PIC_Electrons>>;
    } // namespace particles
} // namespace picongpu
